{
  "name": "flood-data",
  "version": "2.7.1",
  "description": "AWS Lambda project for flood data processing",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "integration-test": "jest test/integration --testTimeout=60000",
    "lint": "eslint .",
    "unit-test": "jest test/unit --coverage",
    "post-deployment-test": "npm run integration-test",
    "pre-deployment-test": "npm run lint && npm run unit-test",
    "test": "npm run lint && npm run unit-test",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {if (e.code !== 'MODULE_NOT_FOUND') { throw e } }\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/flood-data.git"
  },
  "author": "DEFRA",
  "license": "OGL",
  "bugs": {
    "url": "https://github.com/DEFRA/flood-data/issues"
  },
  "homepage": "https://github.com/DEFRA/flood-data#readme",
  "devDependencies": {
    "aws-sdk-client-mock": "4.1.0",
    "dotenv": "18.0.10",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-extended": "7.0.0",
    "mock-knex": "0.4.13",
    "neostandard": "0.14.1"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1030.0",
    "@aws-sdk/client-s3": "3.1030.0",
    "@hapi/wreck": "18.1.2",
    "@smithy/node-http-handler": "4.5.2",
    "async-retry": "1.3.3",
    "axios": "1.20.0",
    "csvtojson": "2.0.14",
    "directly": "2.0.6",
    "joi": "18.2.9",
    "knex": "3.2.10",
    "moment-timezone": "0.6.2",
    "ngr-to-bng": "0.0.1",
    "pg": "8.21.0",
    "verror": "1.10.1",
    "xml2js": "0.6.2"
  }
}
